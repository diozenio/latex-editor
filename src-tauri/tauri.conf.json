{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuillTex",
  "version": "1.1.2",
  "identifier": "dev.quilltex.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "QuillTex",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tectonic",
      "binaries/quilltex-mcp"
    ],
    "resources": {
      "resources/tectonic-cache": "tectonic-cache",
      "resources/texlive": "texlive"
    },
    "category": "Productivity",
    "shortDescription": "Local-first LaTeX editor",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OTFEODhFQzhBNzkyRTIKUldUaWtxZklqdGlSZHBubWQ2UEdGZnJhR3hKazBzWjFiVG5xOWFGV1BiSnJYTUlmbTF5d290cmkK",
      "endpoints": [
        "https://github.com/diozenio/latex-editor/releases/latest/download/latest.json"
      ]
    }
  }
}
